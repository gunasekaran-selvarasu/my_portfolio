# EmailJS & Google reCAPTCHA Configuration
# Rename this file to .env and replace the placeholders with your actual keys.
# These variables should also be set in your Cloudflare Pages Project Settings for production deployment.

# EmailJS Service ID (e.g. gmail service ID)
NEXT_PUBLIC_EMAILJS_SERVICE_ID=

# EmailJS Template ID for Admin Notification (Received by you)
NEXT_PUBLIC_EMAILJS_TEMPLATE_ADMIN=

# EmailJS Template ID for Customer Greetings (Received by the sender)
NEXT_PUBLIC_EMAILJS_TEMPLATE_CUSTOMER=

# EmailJS Public Key (Found in EmailJS Account -> API Keys)
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=

# Google reCAPTCHA v2 (Checkbox) Site Key
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
